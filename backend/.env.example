# RINAVI backend configuration — copy to `backend/.env`

# Every value below is the built-in development default.
# Only uncomment lines you actually change.

# Local development uses SQLite. Switch to PostgreSQL before pilot, e.g.
#   postgresql+asyncpg://rinavi:password@localhost:5432/rinavi
#RINAVI_DATABASE_URL=sqlite+aiosqlite:///./rinavi.db

# Where uploaded vault files are stored
#RINAVI_STORAGE_DIR=./data/vault

# Comma-separated list of allowed browser origins
#RINAVI_CORS_ORIGINS=http://localhost:3000

# WebAuthn (passkey) configuration
#RINAVI_WEBAUTHN_RP_ID=localhost
#RINAVI_WEBAUTHN_ORIGIN=http://localhost:3000
#RINAVI_WEBAUTHN_RP_NAME=RINAVI

# Consent policy version presented to users
#RINAVI_CONSENT_POLICY_VERSION=1.0

# Development sign-in: MUST be disabled outside local development
#RINAVI_DEV_SIGNIN_ENABLED=true

# Session cookie
#RINAVI_COOKIE_SECURE=true
#RINAVI_SESSION_TTL_HOURS=168

#RINAVI_LOG_LEVEL=INFO
