# RINAVI backend configuration — copy to `backend/.env`

# The backend defaults to production and fails closed: dev sign-in, an
# insecure cookie, or a non-HTTPS WebAuthn origin make it refuse to start.
# For local development uncomment the next line. `scripts/dev.sh` sets this
# automatically; do not enable it in a deployed environment.
#RINAVI_ENVIRONMENT=development

# Local development uses SQLite, which remains the default. PostgreSQL is
# supported and exercised in CI: asyncpg ships with the app, and the CI
# parity job runs the whole suite on Postgres 16. The Docker demo will use
# it too, e.g.
#   postgresql+asyncpg://rinavi:CHANGE_ME@localhost:5432/rinavi
#RINAVI_DATABASE_URL=sqlite+aiosqlite:///./rinavi.db

# Test-only override for pytest (read by tests/conftest.py from the real
# environment, not from .env). When set, the suite runs against this
# database instead of a throwaway SQLite file, drops and recreates every
# table on it, and refuses any database whose name does not contain "test".
#RINAVI_TEST_DATABASE_URL=postgresql+asyncpg://rinavi:rinavi@localhost:5432/rinavi_test

# Where uploaded vault files are stored
#RINAVI_STORAGE_DIR=./data/vault

# Document blobs are AES-GCM encrypted at rest when a key is set, and a
# production configuration refuses to start without one. Generate a 32-byte
# key, keep it in a file readable only by the service user, and point at it:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#RINAVI_STORAGE_ENCRYPTION_KEY_FILE=./data/blob.key
# The base64 value may be passed directly instead, but it is then visible in the
# process environment and in crash dumps; prefer the file.
#RINAVI_STORAGE_ENCRYPTION_KEY=

# JSON array of allowed browser origins
#RINAVI_CORS_ORIGINS=["http://localhost:3000"]

# WebAuthn (passkey) configuration
#RINAVI_WEBAUTHN_RP_ID=localhost
#RINAVI_WEBAUTHN_ORIGIN=http://localhost:3000
#RINAVI_WEBAUTHN_RP_NAME=RINAVI

# Consent policy version presented to users
#RINAVI_CONSENT_POLICY_VERSION=1.0

# Development sign-in: defaults to disabled because it is a sign-in bypass.
# Enable it explicitly for local development; scripts/dev.sh sets it
# automatically. MUST be disabled outside local development.
#RINAVI_DEV_SIGNIN_ENABLED=true

# Session cookie
#RINAVI_COOKIE_SECURE=true
#RINAVI_SESSION_TTL_HOURS=168

# Rate limiting (slowapi syntax). The default budget is a per-IP ceiling
# shared by everyone behind one connection; the session budget caps a single
# citizen. The per-route values tighten sensitive endpoints.
#RINAVI_RATE_LIMIT_DEFAULT=1200/hour
#RINAVI_RATE_LIMIT_SESSION=200/hour
#RINAVI_RATE_LIMIT_DEV_SIGNIN=5/minute
#RINAVI_RATE_LIMIT_PASSKEY_BEGIN=10/minute
#RINAVI_RATE_LIMIT_PASSKEY_FINISH=20/minute
#RINAVI_RATE_LIMIT_UPLOAD=30/hour
#RINAVI_RATE_LIMIT_DOCUMENT_CONTENT=100/hour
#RINAVI_RATE_LIMIT_EXPORT=20/hour

# memory:// is per-process: every worker gets its own budget. Use a shared
# backend when running multiple workers or instances. Install the optional
# Redis client first: pip install -e ".[redis]"
#RINAVI_RATE_LIMIT_STORAGE_URI=memory://

# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
# Otherwise clients can spoof the header and dodge per-IP limits.
#RINAVI_TRUST_PROXY_HEADERS=false

#RINAVI_LOG_LEVEL=INFO
