# Copy to .env and adjust. Compose reads these for the host-port
# bindings and the web image's build-time API URL.
#
# WEB_PORT feeds the backend's CORS and WebAuthn origins, so the web
# page keeps working when it moves. API_PORT feeds the API URL baked
# into the web image: after changing it (or NEXT_PUBLIC_API_URL),
# rebuild with `docker compose build web`.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
